{
  "info": {
    "name": "CardService",
    "description": "Postman collection for the diplom-storesys-card-drawer system (CardService + GameService).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Draw card (GameService)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gameServiceUrl}}/draw",
          "host": [
            "{{gameServiceUrl}}"
          ],
          "path": [
            "draw"
          ]
        },
        "description": "The happy path: GameService calls CardService and returns the drawn card as JSON."
      },
      "response": []
    },
    {
      "name": "Draw random card (CardService)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{cardServiceUrl}}/cards/random",
          "host": [
            "{{cardServiceUrl}}"
          ],
          "path": [
            "cards",
            "random"
          ]
        },
        "description": "Draws a random card (52 cards + 3 jokers) with uniform probability and returns it as JSON."
      },
      "response": []
    },
    {
      "name": "Get event feed (CardService)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{cardServiceUrl}}/events?start=0&end=100",
          "host": [
            "{{cardServiceUrl}}"
          ],
          "path": [
            "events"
          ],
          "query": [
            {
              "key": "start",
              "value": "0"
            },
            {
              "key": "end",
              "value": "100"
            }
          ]
        },
        "description": "Returns CardDrawn events raised by CardService, filtered by sequence number range. Each event has sequenceNumber, occurredAt, name, content, and traceId (the W3C trace id of the request that caused it, or null if none)."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "cardServiceUrl",
      "value": "http://localhost:5054",
      "type": "string"
    },
    {
      "key": "gameServiceUrl",
      "value": "http://localhost:5064",
      "type": "string"
    }
  ]
}
