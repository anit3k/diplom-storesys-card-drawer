{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CardService": {
    "BaseUrl": "http://localhost:5054",
    "Resilience": {
      "AttemptTimeout": "00:00:00.500",
      "TotalTimeout": "00:00:03",
      "MaxRetryAttempts": 2,
      "RetryBaseDelay": "00:00:00.200",
      "UseJitter": true,
      "FailureRatio": 0.5,
      "MinimumThroughput": 6,
      "SamplingDuration": "00:00:30",
      "BreakDuration": "00:00:10"
    }
  }
}
